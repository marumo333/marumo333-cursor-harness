{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["./*.contract.ts", "../scripts/lib/**/*.ts"]
}
